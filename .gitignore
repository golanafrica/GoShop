# Crée le fichier .gitignore avec le contenu recommandé
@"
# Binaires et builds
*.exe
*.test
api
bin/
_build/

# Fichiers d'environnement
.env
.env.local
.env.test
.env.development
.env.production

# Documentation OpenAPI générée
/docs/swagger.json
/docs/swagger.yaml

# Couverture de code
coverage.out
coverage.html

# Logs
*.log
logs/

# Dossiers temporaires
tmp/
temp/

# Docker
.dockerignore

# Éditeurs
.vscode/
.idea/
*.swp
*.swo

# MacOS
.DS_Store

# Windows
Thumbs.db
"@ | Out-File -FilePath .gitignore -Encoding utf8
# Tests load results (generated at runtime)
tests/loadtest/results/*.json
tests/loadtest/results/*.html
tests/loadtest/archive.tar
tests/loadtest/results/*.log

# Keep the directory structure
!tests/loadtest/results/.gitkeep
# Fichiers temporaires de test
deposit.json
login.json
register.json
*.exe
*.backup
fix_*.ps1

# ========================================
# FICHIERS TEMPORAIRES v3.0.1
# ========================================

# Fichiers JSON de test
deposit.json
login.json
register.json

# Binaires compil�s
*.exe
*.test
*.out

# Backups
*.backup
*.bak
*.old

# Scripts temporaires
fix_*.ps1
test_*.ps1
debug_*.ps1

# Postman (collections vides)
.postman/
postman/collections/New*/
