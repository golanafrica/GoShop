# Crée le fichier .gitignore avec le contenu recommandé
@"
# ==========================================
# BINAIRES ET BUILDS
# ==========================================
*.exe
*.test
*.out
api
bin/
_build/
*.backup
*.bak
*.old

# ==========================================
# FICHIERS D'ENVIRONNEMENT (CRITIQUE - NE JAMAIS COMMIT)
# ==========================================
.env
.env.local
.env.test
.env.development
.env.production
.env.example

# ==========================================
# DOCUMENTATION OPENAPI GÉNÉRÉE
# ==========================================
/docs/swagger.json
/docs/swagger.yaml

# ==========================================
# COUVERTURE DE CODE
# ==========================================
coverage.out
coverage.html
cover

# ==========================================
# LOGS
# ==========================================
*.log
logs/

# ==========================================
# DOSSIERS TEMPORAIRES
# ==========================================
tmp/
temp/

# ==========================================
# DOCKER
# ==========================================
.dockerignore

# ==========================================
# ÉDITEURS
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# SYSTÈME D'EXPLOITATION
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# TESTS LOAD RESULTS (générés à l'exécution)
# ==========================================
tests/loadtest/results/*.json
tests/loadtest/results/*.html
tests/loadtest/results/*.log
tests/loadtest/archive.tar
!tests/loadtest/results/.gitkeep

# ==========================================
# FICHIERS TEMPORAIRES DE TEST
# ==========================================
deposit.json
login.json
register.json
fix_*.ps1
test_*.ps1
debug_*.ps1

# ==========================================
# POSTMAN (collections vides)
# ==========================================
.postman/
postman/collections/New*/
"@ | Out-File -FilePath .gitignore -Encoding utf8